# Netlify 캐시/보안 헤더 — build/web 로 복사되어 "직접 배포"(GitHub Actions →
# actions-netlify)에서도 반드시 적용되게 한다. (netlify.toml 은 Netlify
# 네이티브 빌드에서만 읽히므로, 직접 배포 경로에서는 이 파일이 필요하다.)

# HTML 엔트리 — 항상 재검증해 새 배포가 즉시 반영되게 한다.
# (특히 모바일 브라우저가 옛 index.html 을 캐시해 옛 앱을 계속 띄우는 문제 방지.)
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Flutter 엔트리/부트스트랩/킬-스위치 SW — 파일명이 고정이므로 항상 재검증.
/flutter_bootstrap.js
  Cache-Control: public, max-age=0, must-revalidate
/main.dart.js
  Cache-Control: public, max-age=0, must-revalidate
/flutter.js
  Cache-Control: public, max-age=0, must-revalidate
/flutter_service_worker.js
  Cache-Control: public, max-age=0, must-revalidate
/version.json
  Cache-Control: public, max-age=0, must-revalidate

# 핑거프린트(해시)된 정적 에셋만 장기 캐싱.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin

# 보안 헤더 — SharedArrayBuffer(WASM) 활성화 + 모바일 호환성.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
